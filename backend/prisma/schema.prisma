// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TEACHER")
  createdAt DateTime @default(now())

  exams        Exam[]
  rooms        Room[]
  classes      Class[]
  activities   Activity[]
  lessonPlans  LessonPlan[]
}

model Class {
  id           String   @id @default(uuid())
  name         String
  subject      String?
  description  String?
  period       String?
  code         String   @unique
  teacherId    String
  teacher      User     @relation(fields: [teacherId], references: [id])
  lessonPlanId String?
  lessonPlan   LessonPlan? @relation(fields: [lessonPlanId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students           ClassStudent[]
  rooms              Room[]
  activities         Activity[]
  attendanceRecords  AttendanceRecord[]
}

model ClassStudent {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  email     String
  joinedAt  DateTime @default(now())

  @@unique([classId, email])
}

// ─── Controle de Presença ────────────────────────────────────────────────────

model AttendanceRecord {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD" — evita timezone headaches
  topic     String?  // Conteúdo da aula
  notes     String?  // Diário de bordo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   AttendanceEntry[]

  @@unique([classId, date])
}

model AttendanceEntry {
  id          String           @id @default(uuid())
  recordId    String
  record      AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  studentId   String           // ClassStudent.id (referência lógica)
  studentName String           // Snapshot — mantém histórico mesmo após remoção do aluno
  present     Boolean          @default(true)

  @@unique([recordId, studentId])
}

// ─── Plano de Aula / Cronograma ──────────────────────────────────────────────

model LessonPlan {
  id          String   @id @default(uuid())
  title       String
  subject     String?  // Disciplina (ex: "Cálculo II")
  description String?
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  classes     Class[]  // Turmas que usam este plano
}

model Lesson {
  id         String     @id @default(uuid())
  planId     String
  plan       LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title      String
  topic      String?    // Conteúdo a ser abordado
  objectives String?    // Objetivos de aprendizagem
  status     String     @default("PLANNED") // "PLANNED" | "DELIVERED" | "CANCELLED"
  order      Int        @default(0)
  createdAt  DateTime   @default(now())

  materials  LessonMaterial[]
  folders    LessonFolder[]
}

model LessonFolder {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  materials LessonMaterial[]
}

model LessonMaterial {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    LessonFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  type      String   // "LINK" | "VIDEO" | "DRIVE" | "FILE"
  title     String
  url       String?  // URL do link ou endpoint do arquivo
  filename  String?  // Nome original (para uploads)
  filesize  Int?     // Bytes
  mimetype  String?  // application/pdf, image/png, etc.
  createdAt DateTime @default(now())
}

// ─── Modelos de Avaliação ────────────────────────────────────────────────────

model Student {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  examSessions ExamSession[]
  answers      Answer[]
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  duration  Int
  weight    Float    @default(1)

  showOneAtATime      Boolean  @default(false)
  randomizeQuestions  Boolean  @default(false)
  randomizeOptions    Boolean  @default(false)
  allowBackNavigation Boolean  @default(true)

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  questions Question[]
  rooms     Room[]
}

model Question {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  statement   String
  pointValue  Float    @default(1)
  scoringMode String   @default("ALL_REQUIRED")

  options  QuestionOption[]
  answers  Answer[]
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
}

model Room {
  id          String   @id @default(uuid())
  name        String   @unique
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  status      String   @default("active")
  createdAt   DateTime @default(now())
  finishedAt  DateTime?

  sessions    ExamSession[]
}

model Answer {
  id                String      @id @default(uuid())
  studentId         String
  student           Student     @relation(fields: [studentId], references: [id])
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId         String
  session           ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  selectedOptionIds String
  score             Float       @default(0)
}

model ExamSession {
  id              String    @id @default(uuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status          String    @default("active")
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  violationsCount Int       @default(0)
  rawScore        Float?
  finalGrade      Float?

  violations Violation[]
  answers    Answer[]
}

model Violation {
  id         String      @id @default(uuid())
  sessionId  String
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       String
  timestamp  DateTime    @default(now())
  screenshot String?
}

// ─── Atividades / Exercícios ─────────────────────────────────────────────────

model Activity {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        String    @default("EXERCISE")
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id])
  dueDate     DateTime?
  isOpen      Boolean   @default(true)
  code        String    @unique
  createdAt   DateTime  @default(now())

  questions   ActivityQuestion[]
  submissions ActivitySubmission[]

  fileUrl     String?
  filename    String?
}

model ActivityQuestion {
  id         String   @id @default(uuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  statement  String
  type       String   @default("TEXT")
  order      Int      @default(0)

  options ActivityOption[]
  answers ActivityAnswer[]
}

model ActivityOption {
  id         String           @id @default(uuid())
  questionId String
  question   ActivityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
}

model ActivitySubmission {
  id           String   @id @default(uuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentName  String
  studentEmail String
  grade        Float?   // Nota do aluno
  submittedAt  DateTime @default(now())

  fileUrl      String?
  filename     String?

  answers ActivityAnswer[]

  @@unique([activityId, studentEmail])
}

model ActivityAnswer {
  id               String             @id @default(uuid())
  submissionId     String
  submission       ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId       String
  question         ActivityQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textAnswer       String?
  selectedOptionId String?
  fileUrl          String?            // URL do arquivo anexado
  filename         String?            // Nome do arquivo anexado
}
